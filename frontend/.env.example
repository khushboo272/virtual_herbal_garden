# ── Virtual Herbal Garden — Frontend Environment Variables ──

# Backend API URL (Vite injects this at build time)
# For local development, leave blank — Vite proxy handles /api routes.
# For production, set to your backend URL, e.g.:
#   VITE_API_URL=https://your-backend.onrender.com/api/v1
VITE_API_URL=
